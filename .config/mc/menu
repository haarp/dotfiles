shell_patterns=0

# see `man mc` "Edit Menu File"
# also see https://github.com/MidnightCommander/mc/blob/master/misc/mc.menu.in

+
! Create empty file
	f=%{Filename}
	touch "$f"

+ (t d & ! t t) | t t
c Recursive chmod dir(s) with chmodr
	mode=%{Octal *file* mode}
	export mode
	unset MC_SID
	bash -i -c 'chmodr "$mode" %s'

+
3 Compress file(s) (tar.gz)
	pwd=$(basename %d /)
	read -r -p "Archive name (without extension) [$pwd]: " name
	[ -z "$name" ] && name="$pwd"
	tar cf "$name.tar.gz" -z %s

+
6 Compress file(s) (tar.xz)
	pwd=$(basename %d /)
	read -r -p "Archive name (without extension) [$pwd]: " name
	[ -z "$name" ] && name="$pwd"
	tar cf "$name.tar.xz" -J %s

+ t r | t t
A Append files(s) to opposite file(s) of same name
	for f in %s ; do
		cat "$f" >> "%D/$f"
	done

+ t r & ! t t
d Delete file if a copy exists in the other directory.
	if [ %d = %D ]; then
		echo "The two directories must be different."
		exit 1
	fi
	if [ -f %D/%f ]; then		# if two of them, then
		if cmp -s %D/%f %f; then
			rm %f && echo %f": DELETED."
		else
			echo %f" and "%D/%f" differ: NOT deleted."
			echo -n "Press RETURN "
			read key
		fi
	else
		echo %f": No copy in "%D/%f": NOT deleted."
	fi

+ t t
D Delete tagged files if a copy exists in the other directory.
	if [ %d = %D ]; then
		echo "The two directores must be different."
		exit 1
	fi
	for i in %t ; do
		if [ -f %D/"$i" ]; then
			SUM1=`sum "$i"`
			SUM2=`sum %D/"$i"`
			if [ "$SUM1" = "$SUM2" ]; then
				rm "$i" && echo "${i}: DELETED."
			else
				echo "$i and "%D"/$i differ: NOT deleted."
			fi
		else
			echo "$i has no copy in "%D": NOT deleted."
		fi
	done
