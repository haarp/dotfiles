# man lesskey

# F2, c : toggle line wrapping aka chop (without confirmation)
\eOQ	toggle-option ^PS
c		toggle-option ^PS

# F3, F10: quit as in mcview
\eOR	quit
\e[21~	quit

# F7: search w/ wraparound (https://unix.stackexchange.com/a/621514)
\e[18~	forw-search ^W

# , .: switch files
,		prev-file
.		next-file
