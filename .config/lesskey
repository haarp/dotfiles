# man lesskey

# F2, s : toggle line wrapping aka chop (without confirmation)
\eOQ	toggle-option ^PS
s		toggle-option ^PS

# F3 (graphical), F3 (linux console), F10: quit as in mcview
\eOR	quit
\e[[C	quit
\e[21~	quit

# F7: search w/ wraparound (https://unix.stackexchange.com/a/621514)
\e[18~	forw-search ^W

# comma, period: switch files
[		prev-file
]		next-file

# shift+pgup/pgdn: scroll 5 pages at once
\e[5;2~	noaction bbbbb
\e[6;2~	noaction fffff
