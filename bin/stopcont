#!/bin/bash
# FIXME: doesn't work for firejail'ed windows (https://github.com/netblue30/firejail/discussions/5967)
# or tabbed because it sets no _NET_WM_PID

# https://superuser.com/a/784102
pidtree() (
	children=()
	while read -r p pp; do
		children[$pp]+=" $p"
	done <<< "$(ps -e -o pid= -o ppid=)"

	walk() {
		for i in ${children[$1]};do
			echo "$i"
			walk "$i"
		done
	}

	for i in "$@";do
		walk "$i"
	done
)

# Reads raw key events from all keyboards
# and kills the given PID on ESC (keycode 9)
# Fed via fd $esc_fd
watch_esc() {
	local line type=''
	while read -r line <&"$esc_fd"; do
		case "$line" in
			"EVENT type "*)
				type=${line##*(}
				type=${type%)};;
			"detail: 9")
				if [[ "$type" == RawKeyPress ]]; then
					kill "$1" 2>/dev/null
					return
				fi;;
		esac
	done
}

exec {xprop_fd}< <(xprop _NET_WM_PID)
xprop_pid=$!

exec {esc_fd}< <(stdbuf -oL xinput test-xi2 --root)
xinput_pid=$!

watch_esc "$xprop_pid" &
watcher_pid=$!

trap 'kill "$xprop_pid" "$xinput_pid" "$watcher_pid" 2>/dev/null' EXIT

# read pid from xprop, or die when pipe closes
read -u "$xprop_fd" pid || exit 1

pid=${pid#_NET_WM_PID(CARDINAL) = }
kill -0 "$pid" 2>/dev/null || {
	echo "PID \`$pid\` unusable!"
	exit 1
}

name="$(readlink "/proc/$pid/exe")"
name="${name##*/}"

if grep -q ^State:$'\t'T "/proc/$pid/status"; then
	notify-send -i media-playback-start "${0##*/}" "Continuing $name"
	kill -CONT "$pid" $(pidtree "$pid")
else
	notify-send -i media-playback-pause "${0##*/}" "Stopping $name"
	kill -STOP "$pid" $(pidtree "$pid")
fi

exit 0
